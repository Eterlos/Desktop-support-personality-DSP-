<Window x:Class="dcp_project.CharacterSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Настройка персонажа"
        Height="260" Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Выберите персонажа:" Margin="0,0,0,15" FontSize="14"/>

        <StackPanel Grid.Row="1">
            <RadioButton Content="base_normal" x:Name="RadioBase" GroupName="Character" Margin="0,6,0,6" FontSize="13"/>
            <RadioButton Content="maid_normal" x:Name="RadioMaid" GroupName="Character" Margin="0,6,0,6" FontSize="13"/>
            <RadioButton Content="gyro_normal" x:Name="RadioGyro" GroupName="Character" Margin="0,6,0,6" FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Отмена" Width="80" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Применить" Width="100" Click="Apply_Click"/>
        </StackPanel>
    </Grid>
</Window>