<Window x:Class="dcp_project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:dcp_project"
        mc:Ignorable="d"
        Title="Desktop Assistant"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Универсальный стиль для темных скругленных кнопок -->
        <Style TargetType="Button">
            <!-- Базовые свойства текста и шрифта -->
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            
            <!-- Полное переопределение визуальной структуры кнопки -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Border задает цвет фона, обводку и скругление углов -->
                        <Border x:Name="ButtonBorder" 
                                Background="#2D2D30" 
                                BorderBrush="#3F3F46" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                SnapsToDevicePixels="True">
                            <!-- ContentPresenter выводит текст или иконку внутри кнопки -->
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        
                        <!-- Интерактивные триггеры для анимации состояния -->
                        <ControlTemplate.Triggers>
                            <!-- При наведении мыши кнопка плавно светлеет -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3E3E42"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <!-- При нажатии кнопка становится еще темнее -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E1E1E"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ваше кастомное крестовое меню с исправленной кодировкой иконок -->
        <ContextMenu x:Key="AssistantMenu" Background="Transparent" BorderBrush="Transparent" HasDropShadow="False">
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Width="360" Height="360">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ВЕРХ -->
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                            <Button Content="..." Width="80" Height="25" Margin="0,2"/>
                            <Button Content="..." Width="80" Height="25" Margin="0,2"/>
                            <Button Content="ФУНКЦИЯ 1" Width="80" Height="30" Margin="0,2"/>
                        </StackPanel>

                        <!-- ЛЕВО -->
                        <Button Grid.Row="1" Grid.Column="0" Content="▶ ПЛЕЕР" Width="80" Height="50" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5,0"/>

                        <!-- ПРАВО -->
                        <Button Grid.Row="1" Grid.Column="2" Content="ЧАТ" Width="80" Height="50" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0"/>

                        <!-- НИЗ -->
                        <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,5">
                            <Button Content="⚙ ПЕРСОНАЖ" Width="90" Height="30" Margin="0,2" Click="OpenSettings_Click"/>
                            <Button Content="❌ ЗАКРЫТЬ" Width="90" Height="40" Click="CloseApp_Click" Margin="0,5"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </ContextMenu.Template>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <local:PixelPerfectImage x:Name="AssistantImage"
                                 Stretch="Uniform"
                                 Width="300"
                                 Height="300"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="10">
            <local:PixelPerfectImage.RenderTransform>
                <TranslateTransform x:Name="ImageTransform"/>
            </local:PixelPerfectImage.RenderTransform>
        </local:PixelPerfectImage>
    </Grid>
</Window>
