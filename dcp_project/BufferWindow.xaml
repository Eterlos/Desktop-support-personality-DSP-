<Window x:Class="dcp_project.BufferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Буфер" Width="430" Height="560" MinWidth="360" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E"
        Foreground="#E0E0E0" FontFamily="Segoe UI" ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#26394A"/>
                    <Setter Property="BorderBrush" Value="#007ACC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <StackPanel>
                <TextBlock Text="БУФЕР" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Выбери несколько элементов и перетащи их в Telegram или другое приложение."
                           Foreground="#A0A0A0" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Top"
                       Foreground="#A0A0A0" Margin="10,5,0,0"/>
        </DockPanel>
        <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,6,0,10">
            <TextBlock Text="Можно хранить до 20 элементов" Foreground="#8A8A8A"
                       VerticalAlignment="Center"/>
            <Button Content="Удалить выбранное" Click="RemoveSelected_Click"/>
            <Button Content="Очистить" Click="Clear_Click" Background="#512B2B" BorderBrush="#754040"/>
        </DockPanel>
        <ListBox x:Name="ItemsList" Grid.Row="2" SelectionMode="Extended"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 PreviewMouseLeftButtonDown="ItemsList_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="ItemsList_PreviewMouseMove">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="54" Height="54" CornerRadius="5"
                                Background="#353539" ClipToBounds="True" VerticalAlignment="Top">
                            <Grid>
                                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"/>
                                <TextBlock Text="{Binding Kind}" FontSize="9" FontWeight="Bold"
                                           Foreground="White" Background="#AA202024"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           Padding="4,2"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" MinWidth="0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                            <TextBlock Text="{Binding PreviewText}" Foreground="#AFAFAF"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       MaxHeight="54" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="EmptyText" Grid.Row="2" Text="Перетащи сюда текст, фотографии или файлы"
                   Foreground="#777777" TextAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False" Visibility="Collapsed"/>
        <TextBlock Grid.Row="3" Text="Подсказка: Ctrl или Shift помогает выбрать несколько записей."
                   Foreground="#777777" FontSize="11" Margin="0,9,0,0"/>
    </Grid>
</Window>
