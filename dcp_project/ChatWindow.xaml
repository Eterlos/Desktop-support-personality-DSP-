<Window x:Class="dcp_project.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Чат" Width="560" Height="520" MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterScreen" Topmost="True"
        WindowStyle="None" ResizeMode="CanResize" Background="White">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#888888" BorderThickness="1">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="#EEEEEE" Height="30" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Button DockPanel.Dock="Right" Content="—" Width="42" ToolTip="Свернуть"
                    AutomationProperties.Name="Свернуть чат" Click="Minimize_Click"/>
            <TextBlock Text="Чат DSP" Margin="10,0" VerticalAlignment="Center"/>
        </DockPanel>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8">
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Обновить модели" Padding="8,4" Margin="8,0,0,0" Click="Refresh_Click"/>
                <ComboBox x:Name="ModelPicker" MinHeight="28" AutomationProperties.Name="Локальная модель Ollama" SelectionChanged="ModelPicker_SelectionChanged"/>
            </DockPanel>
            <TextBlock x:Name="StatusText" Text="Подключение к Ollama…" TextWrapping="Wrap"/>
            <TextBlock x:Name="ElapsedText" Text="Время запроса: 00:00.000"/>
            <TextBlock Margin="0,4,0,0">
                <Hyperlink NavigateUri="dsp://settings/behavior" RequestNavigate="BehaviorLink_RequestNavigate"
                           ToolTip="Открыть файл в Блокноте">Инструкции поведения</Hyperlink>
            </TextBlock>
        </StackPanel>
        <RichTextBox x:Name="Transcript" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="История чата">
            <FlowDocument FontFamily="Segoe UI" FontSize="14" PagePadding="8"/>
        </RichTextBox>
        <TextBox x:Name="MessageInput" Grid.Row="2" MinHeight="32" Margin="0,8,0,8"
                 VerticalContentAlignment="Center" KeyDown="MessageInput_KeyDown"
                 AutomationProperties.Name="Сообщение"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button x:Name="SendButton" Content="Отправить" Padding="12,5" IsEnabled="False" Click="Send_Click"/>
            <Button x:Name="CancelButton" Content="Стоп" Margin="8,0,0,0" Padding="12,5" IsEnabled="False" Click="Cancel_Click"/>
            <Button x:Name="ClearButton" Content="Очистить" Margin="8,0,0,0" Padding="12,5" Click="Clear_Click"/>
        </StackPanel>
    </Grid>
    </DockPanel>
    </Border>
</Window>
