<Window x:Class="dcp_project.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат" Width="560" Height="520" MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8">
            <DockPanel Margin="0,0,0,8">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Обновить модели" Padding="8,4" Margin="8,0,0,0" Click="Refresh_Click"/>
                <ComboBox x:Name="ModelPicker" MinHeight="28" AutomationProperties.Name="Локальная модель Ollama" SelectionChanged="ModelPicker_SelectionChanged"/>
            </DockPanel>
            <TextBlock x:Name="StatusText" Text="Подключение к Ollama…" TextWrapping="Wrap"/>
        </StackPanel>
        <RichTextBox x:Name="Transcript" Grid.Row="1" IsReadOnly="True" IsDocumentEnabled="True"
                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="История чата">
            <FlowDocument FontFamily="Segoe UI" FontSize="14" PagePadding="8"/>
        </RichTextBox>
        <TextBox x:Name="MessageInput" Grid.Row="2" MinHeight="32" Margin="0,8,0,8"
                 VerticalContentAlignment="Center" KeyDown="MessageInput_KeyDown"
                 AutomationProperties.Name="Сообщение"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button x:Name="SendButton" Content="Отправить" Padding="12,5" IsEnabled="False" Click="Send_Click"/>
            <Button x:Name="CancelButton" Content="Отменить" Margin="8,0,0,0" Padding="12,5" IsEnabled="False" Click="Cancel_Click"/>
            <Button x:Name="ClearButton" Content="Очистить" Margin="8,0,0,0" Padding="12,5" Click="Clear_Click"/>
        </StackPanel>
    </Grid>
</Window>
